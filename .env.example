# Variables de un proyecto Supabase EN LA NUBE. Solo URL y clave PUBLICA (anon / publishable).
# NUNCA pongas aqui la clave de servicio (secret): la app la rechaza y los tests fallan si aparece en el repo.
EXPO_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Pruebas locales (Docker, npm run db:start): URL http://127.0.0.1:3160 y la anon key que imprime `supabase status`
